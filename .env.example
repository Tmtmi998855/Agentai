# Application Settings
APP_NAME="Ah! There Backend V0"
APP_ENV="development"
DEBUG=true

# 파이프라인 모드: mock(가상 데이터) | live(실제 검색·원문 확인·LLM)
PIPELINE_MODE="mock"

# Reasoning Provider Settings
# Options: mock | openai_compatible | codex_cli
REASONING_PROVIDER="mock"

# Codex CLI (PC에 로그인된 Codex로 GPT-6 Luna 사용, API 키 불필요)
CODEX_COMMAND="codex"
# 모델 오류가 나면 빈 값("")으로 두세요. Codex에 설정된 기본 모델을 씁니다.
CODEX_MODEL="gpt-6-luna"
CODEX_TIMEOUT_SECONDS=180

# OpenAI Compatible Provider Settings (OmniRoute / Groq / Cerebras / OpenRouter / AI Studio)
OPENAI_BASE_URL="http://localhost:20128/v1"
OPENAI_API_KEY="your-api-key-here"
REASONING_MODEL="auto/best-coding"
TIMEOUT_SECONDS=30
MAX_RETRIES=1

# Perplexity Search Provider Settings (V0.5+)
PERPLEXITY_API_KEY=""
PERPLEXITY_BASE_URL="https://api.perplexity.ai"

# Search Provider: mock | perplexity
SEARCH_PROVIDER="mock"

# 원문 수집 추가 CA (회사망/클라우드처럼 HTTPS를 중계하는 환경에서만 지정, 보통 비워 둠)
RAW_FETCH_CA_BUNDLE=""

# Report Store: memory | supabase
REPORT_STORE="memory"
SUPABASE_URL=""
# 서버 전용 키. 브라우저/Next.js 클라이언트 번들에 절대 넣지 마세요.
SUPABASE_SERVICE_ROLE_KEY=""
# 도메인 미보유: 로컬 기본값. Vercel 배포 후 https://<project>.vercel.app/report 로 교체
REPORT_BASE_URL="http://localhost:3000/report"

# MCP 서버 소유자 (Hermes의 TELEGRAM_ALLOWED_USERS와 같은 숫자 ID로 설정)
AH_THERE_MESSENGER_TYPE="telegram"
AH_THERE_OWNER_USER_ID=""
