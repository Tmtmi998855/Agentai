# Application Settings
APP_NAME="Ah! There Backend V0"
APP_ENV="development"
DEBUG=true

# Reasoning Provider Settings
# Options: mock | openai_compatible
REASONING_PROVIDER="mock"

# OpenAI Compatible Provider Settings (OmniRoute / Groq / Cerebras / OpenRouter / AI Studio)
OPENAI_BASE_URL="http://localhost:20128/v1"
OPENAI_API_KEY="your-api-key-here"
REASONING_MODEL="auto/best-coding"
TIMEOUT_SECONDS=30
MAX_RETRIES=1

# Perplexity Search Provider Settings (V0.5+)
PERPLEXITY_API_KEY=""
PERPLEXITY_BASE_URL="https://api.perplexity.ai"

# Search Provider: mock | perplexity
SEARCH_PROVIDER="mock"

# Report Store: memory | supabase
REPORT_STORE="memory"
SUPABASE_URL=""
# 서버 전용 키. 브라우저/Next.js 클라이언트 번들에 절대 넣지 마세요.
SUPABASE_SERVICE_ROLE_KEY=""
REPORT_BASE_URL="https://ahthere.com/report"
